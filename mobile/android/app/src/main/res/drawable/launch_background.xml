<?xml version="1.0" encoding="utf-8"?>
<!-- FamilyBoard launch screen: brand background + centered bullseye.
     `launch_background_color` and `launch_image` both flip automatically
     for dark mode via the `-night` resource qualifier. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background_color" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_image" />
    </item>
</layer-list>
